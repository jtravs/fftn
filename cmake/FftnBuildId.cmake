#
# Script mode (cmake -P): writes OUTPUT, a C++ unit defining fftn::detail::build_id(), the
# first 16 hexadecimal digits of a SHA-256 over the build's configuration line and the
# content of every file listed in LIST (one path per line after the first, which is the
# configuration). Wisdom records carry it beside the version (src/core/wisdom.cpp), since
# the version stays the same across development commits: an entry recorded by one build is
# used only by a build of the same sources and configuration.

file(STRINGS "${LIST}" lines)
list(POP_FRONT lines configuration)
set(digest "${configuration}\n")
foreach(path IN LISTS lines)
  file(SHA256 "${path}" file_hash)
  file(RELATIVE_PATH name "${ROOT}" "${path}")
  string(APPEND digest "${name} ${file_hash}\n")
endforeach()
string(SHA256 id "${digest}")
string(SUBSTRING "${id}" 0 16 id)
set(content "// Generated by cmake/FftnBuildId.cmake; do not edit.
#include \"core/build_id.hpp\"

namespace fftn::inline v0::detail {
const char* build_id() noexcept { return \"${id}\"; }
} // namespace fftn::inline v0::detail
")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
else()
  set(old "")
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
else()
  # Ninja reruns a command whose output is older than its inputs: refresh the time stamp
  # only, so that the unit is not recompiled when the hash is unchanged.
  file(TOUCH_NOCREATE "${OUTPUT}")
endif()
